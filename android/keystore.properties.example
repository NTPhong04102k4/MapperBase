# Copy thành android/keystore.properties (file này ĐÃ nằm trong .gitignore).
# Không có file này thì buildType release sẽ ký bằng debug key + in cảnh báo.
#
# Tạo upload keystore:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore ~/keystores/mapper-upload.keystore \
#     -alias mapper-upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile tính tương đối từ thư mục android/ (hoặc dùng đường dẫn tuyệt đối).

storeFile=../keystores/mapper-upload.keystore
storePassword=CHANGE_ME
keyAlias=mapper-upload
keyPassword=CHANGE_ME
