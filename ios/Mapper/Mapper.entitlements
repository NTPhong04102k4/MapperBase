<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push: development cho Debug, production cho Release.
	     Xcode tự đổi giá trị này khi archive nếu dùng automatic signing;
	     với manual signing phải tạo 2 file entitlements riêng. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- App Group: kênh duy nhất chia sẻ dữ liệu app <-> WidgetKit extension.
	     Giá trị lấy từ xcconfig theo flavor:
	       group.com.mapper.dev / .staging / group.com.mapper -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP)</string>
	</array>

	<!-- Keychain sharing giữa app và extension (refresh token, snapshot key) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
