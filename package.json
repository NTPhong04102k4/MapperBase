{
  "name": "Mapper",
  "version": "1.0.0",
  "buildNumbers": {
    "dev": 1,
    "staging": 1,
    "prod": 1
  },
  "private": true,
  "scripts": {
    "start": "react-native start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" App.tsx \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" App.tsx \"*.js\"",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "verify": "yarn lint && yarn format:check && yarn tsc && yarn test",
    "bump:dev": "node scripts/bump.js build dev",
    "bump:staging": "node scripts/bump.js build staging",
    "bump:prod": "node scripts/bump.js build prod",
    "bump:all": "node scripts/bump.js build all",
    "release:patch": "node scripts/bump.js patch all",
    "release:minor": "node scripts/bump.js minor all",
    "release:major": "node scripts/bump.js major all",
    "version:print": "node scripts/bump.js print",
    "version:sync": "node scripts/bump.js sync",
    "postinstall": "node scripts/bump.js sync",
    "android": "yarn android:dev",
    "android:dev": "react-native run-android --mode=devDebug --appId com.mapper.dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appId com.mapper.staging",
    "android:prod": "react-native run-android --mode=prodDebug --appId com.mapper",
    "apk:dev": "cd android && ./gradlew assembleDevRelease",
    "apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "apk:prod": "cd android && ./gradlew assembleProdRelease",
    "aab:dev": "cd android && ./gradlew bundleDevRelease",
    "aab:staging": "cd android && ./gradlew bundleStagingRelease",
    "aab:prod": "cd android && ./gradlew bundleProdRelease",
    "ios": "yarn ios:dev",
    "ios:dev": "react-native run-ios --scheme \"Mapper Dev\" --mode \"Debug Dev\"",
    "ios:staging": "react-native run-ios --scheme \"Mapper Staging\" --mode \"Debug Staging\"",
    "ios:prod": "react-native run-ios --scheme \"Mapper\" --mode \"Debug Prod\"",
    "pods": "cd ios && bundle exec pod install",
    "assets:link": "react-native-asset",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && rm -rf build Pods Podfile.lock && bundle exec pod install"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@notifee/react-native": "9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/drawer": "^7.13.5",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "dayjs": "^1.11.20",
    "i18next": "^26.3.2",
    "react": "19.0.0",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.79.0",
    "react-native-fbsdk-next": "13.4.3",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-reanimated": "4.1.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "4.14.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.3.0",
    "redux-saga": "^1.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "8.57.1",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.0",
    "@react-native/eslint-config": "0.79.0",
    "@react-native/metro-config": "0.79.0",
    "@react-native/typescript-config": "0.79.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "^2.3.0",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=18"
  }
}
